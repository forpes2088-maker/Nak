def check_login():
    hwid = get_hwid()
    info = get_device_info()

    clear_screen()
    show_banner()
    print("  +----------------------------------------------+")
    print("  |            >> LOGIN REQUIRED <<              |")
    print("  +----------------------------------------------+")
    print("")
    print("  [*] Device  : " + info["device"])
    print("  [*] OS      : " + info["os"])
    print("  [*] HWID    : " + hwid)
    print("  [*] Server  : " + SERVER_URL)
    print("")

    cached = load_session()
    if cached and cached.get("hwid") == hwid and cached.get("ok"):
        try:
            exp = datetime.datetime.fromisoformat(cached["expiry"])
            if datetime.datetime.now() < exp:
                print("  [✓] Session cached until " + str(exp))
                print("")
                return True
        except Exception:
            pass

    attempts = 3
    while attempts > 0:
        try:
            key = getpass.getpass("  [>] Enter Login Key: ").strip()
        except Exception:
            key = input("  [>] Enter Login Key: ").strip()

        if not key:
            attempts -= 1
            print("  [!] Empty key. Attempts left: " + str(attempts))
            continue

        print("  [*] Contacting server...")
        res = server_check(key, hwid)

        if res is None:
            print("  [!] Server unreachable.")
            print("  [!] Is admin_panel.py running?")
            return False

        if res.get("ok"):
            expiry = res.get("expiry", "")
            save_session({
                "ok": True,
                "key": key,
                "hwid": hwid,
                "expiry": expiry,
            })
            clear_screen()
            show_banner()
            print("  +----------------------------------------------+")
            print("  |           >> LOGIN SUCCESS <<                |")
            print("  +----------------------------------------------+")
            print("")
            print("  [✓] Key     : " + key)
            print("  [✓] Expires : " + expiry)
            print("")
            return True

        reason = res.get("reason", "denied")

        if reason == "invalid_key":
            attempts -= 1
            print("  [!] Key not found. Attempts left: " + str(attempts))
        elif reason == "expired":
            print("  [!] License EXPIRED (" + str(res.get("expiry", "")) + ")")
            return False
        elif reason == "hwid_mismatch":
            print("  [!] Key bound to another PC")
            print("  [!] Bound HWID: " + str(res.get("bound_hwid", "?")))
            return False
        else:
            attempts -= 1
            print("  [!] Denied: " + reason + ". Attempts left: " + str(attempts))

    print("  [X] Access denied.")
    return False


