LUJIT_SIG = b"\x1bLJ"


def _read(path):
    with open(path, "rb") as f:
        return bytearray(f.read())


def _write(path, data):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "wb") as f:
        f.write(data)


def hexdump(data, offset=0, length=256):
    chunk = data[offset:offset + length]
    lines = []
    for i in range(0, len(chunk), 16):
        row = chunk[i:i + 16]
        hex_part = " ".join("%02X" % b for b in row)
        ascii_part = "".join(chr(b) if 32 <= b < 127 else "." for b in row)
        lines.append("  %08X  %-47s  |%s|" % (offset + i, hex_part, ascii_part))
    return "\n".join(lines)


def inspect_file(path):
    data = _read(path)
    print("")
    print("  [*] File: " + path)
    print("  [*] Size: " + str(len(data)) + " bytes")

    if data.startswith(LUJIT_SIG):
        print("")
        print("  [*] Format: LuaJIT bytecode")
        print("  [*] Version: " + str(data[3] if len(data) > 3 else 0))
        flags = data[4] if len(data) > 4 else 0
        print("  [*] Flags  : 0x%02X" % flags)
        print("      big_endian: " + str(bool(flags & 0x01)))
        print("      stripped  : " + str(bool(flags & 0x02)))
        print("      ffi       : " + str(bool(flags & 0x04)))
        print("      fr2       : " + str(bool(flags & 0x08)))
    elif data.startswith(b"\x1bLua"):
        print("")
        print("  [*] Format: Lua 5.1/5.2/5.3 bytecode")
    else:
        print("")
        print("  [!] Format: Unknown")

    print("")
    print("  [*] Hex dump (first 256 bytes):")
    print(hexdump(data, 0, 256))


def patch_bytes(path, offset, new_bytes_hex, out_path=None):
    data = _read(path)
    try:
        patch = bytes.fromhex(new_bytes_hex.replace(" ", ""))
    except ValueError:
        print("  [!] Invalid hex string.")
        return
    if offset + len(patch) > len(data):
        print("  [!] Patch exceeds file size.")
        return
    original = data[offset:offset + len(patch)]
    data[offset:offset + len(patch)] = patch
    out_path = out_path or path
    _write(out_path, data)
    print("  [✓] Patched " + str(len(patch)) + " byte(s) at 0x%X" % offset)
    print("      Before: " + " ".join("%02X" % b for b in original))
    print("      After : " + " ".join("%02X" % b for b in patch))
    print("      Saved : " + out_path)


def find_pattern(path, hex_pattern):
    data = _read(path)
    try:
        pat = bytes.fromhex(hex_pattern.replace(" ", ""))
    except ValueError:
        print("  [!] Invalid hex pattern.")
        return []
    matches = []
    start = 0
    while True:
        idx = data.find(pat, start)
        if idx == -1:
            break
        matches.append(idx)
        start = idx + 1
    if matches:
        print("  [✓] Found " + str(len(matches)) + " match(es):")
        for m in matches:
            print("      0x%08X" % m)
    else:
        print("  [!] No matches found.")
    return matches


def replace_pattern(path, old_hex, new_hex, out_path=None):
    data = _read(path)
    try:
        old = bytes.fromhex(old_hex.replace(" ", ""))
        new = bytes.fromhex(new_hex.replace(" ", ""))
    except ValueError:
        print("  [!] Invalid hex.")
        return
    if len(old) != len(new):
        print("  [!] Lengths differ.")
        return
    count = data.count(old)
    if count == 0:
        print("  [!] Pattern not found.")
        return
    data = data.replace(old, new)
    out_path = out_path or path
    _write(out_path, data)
    print("  [✓] Replaced " + str(count) + " occurrence(s) -> " + out_path)


def set_flag(path, flag_name, enabled, out_path=None):
    data = _read(path)
    if not data.startswith(LUJIT_SIG):
        print("  [!] Not a LuaJIT bytecode file.")
        return
    flag_bits = {
        "big_endian": 0x01,
        "stripped":   0x02,
        "ffi":        0x04,
        "fr2":        0x08,
    }
    if flag_name not in flag_bits:
        print("  [!] Unknown flag: " + flag_name)
        print("      Available: " + str(list(flag_bits.keys())))
        return
    bit = flag_bits[flag_name]
    if enabled:
        data[4] |= bit
    else:
        data[4] &= ~bit
    out_path = out_path or path
    _write(out_path, data)
    state = "ON" if enabled else "OFF"
    print("  [✓] Flag '" + flag_name + "' set " + state + " -> " + out_path)


