# ============================================================

class PakEntry:
    def __init__(self, name, offset, size, compressed):
        self.name = name
        self.offset = offset
        self.size = size
        self.compressed = compressed


def unpack_pak(pak_path, out_dir):
    print("  [*] Unpacking: " + pak_path)
    os.makedirs(out_dir, exist_ok=True)

    with open(pak_path, "rb") as f:
        magic = f.read(4)

        if magic == b"NAKP":
            count = struct.unpack("<I", f.read(4))[0]
            entries = []
            for _ in range(count):
                name_len = struct.unpack("<H", f.read(2))[0]
                name = f.read(name_len).decode("utf-8", "ignore")
                offset, size, comp = struct.unpack("<IIB", f.read(9))
                entries.append(PakEntry(name, offset, size, comp))

            for e in entries:
                f.seek(e.offset)
                blob = f.read(e.size)

                if e.compressed:
                    try:
                        blob = zlib.decompress(blob)
                    except Exception as ex:
                        print("  [!] Decompress failed for " + e.name + ": " + str(ex))

                target = os.path.join(out_dir, e.name)
                os.makedirs(os.path.dirname(target) or out_dir, exist_ok=True)
                with open(target, "wb") as o:
                    o.write(blob)

                print("  [✓] " + e.name + "  (" + str(len(blob)) + " bytes)")

            print("  [✓] Unpack complete -> " + out_dir)
            return

        else:
            f.seek(0)
            data = f.read()
            out_file = os.path.join(out_dir, os.path.basename(pak_path) + ".bin")
            with open(out_file, "wb") as o:
                o.write(data)
            print("  [!] Unknown format, dumped raw -> " + out_file)


def repak_folder(folder, out_pak, compress=False):
    print("  [*] Repacking: " + folder + " -> " + out_pak)

    files = []
    for root, _, names in os.walk(folder):
        for n in names:
            full = os.path.join(root, n)
            rel = os.path.relpath(full, folder).replace("\\", "/")
            files.append((rel, full))

    if not files:
        print("  [!] No files found.")
        return

    index_size = 0
    for name, _ in files:
        nb = name.encode("utf-8")
        index_size += 2 + len(nb) + 4 + 4 + 1

    data_offset = 8 + index_size

    header = b"NAKP" + struct.pack("<I", len(files))
    entries_index = bytearray()
    body = bytearray()

    for name, full in files:
        with open(full, "rb") as f:
            data = f.read()

        if compress:
            data = zlib.compress(data)

        nb = name.encode("utf-8")
        entries_index += struct.pack("<H", len(nb)) + nb
        entries_index += struct.pack("<IIB",
                                     data_offset + len(body),
                                     len(data),
                                     1 if compress else 0)
        body += data

    with open(out_pak, "wb") as f:
        f.write(header)
        f.write(entries_index)
        f.write(body)

    print("  [✓] Repacked " + str(len(files)) + " files -> " + out_pak)


