try:
    import xxtea
    HAS_XXTEA = True
except ImportError:
    HAS_XXTEA = False


LUA_SIGNATURES = {
    b"\x1bLua":  "Lua 5.1/5.2/5.3 bytecode",
    b"\x1bLuaQ": "LuaJIT bytecode",
    b"\x1bLJ":   "LuaJIT bytecode (alt)",
}


def detect_lua_type(data):
    for sig, name in LUA_SIGNATURES.items():
        if data.startswith(sig):
            return name
    head = data[:2048]
    if b"function" in head or b"local" in head or b"return" in head:
        return "Plain-text Lua source"
    return "Unknown / Encrypted"


def xxtea_decrypt(data, key):
    if not HAS_XXTEA:
        raise RuntimeError("Install xxtea: pip install xxtea")
    return xxtea.decrypt(data, key, padding=False)


def xxtea_encrypt(data, key):
    if not HAS_XXTEA:
        raise RuntimeError("Install xxtea: pip install xxtea")
    return xxtea.encrypt(data, key, padding=False)


def xor_decrypt(data, key):
    return bytes(b ^ key[i % len(key)] for i, b in enumerate(data))


def decrypt_file(in_path, out_path, method="xxtea", key="NAK2026VIP"):
    print("  [*] Reading: " + in_path)
    with open(in_path, "rb") as f:
        raw = f.read()

    kind = detect_lua_type(raw)
    print("  [*] Detected: " + kind)

    if "Plain-text" in kind:
        out = raw
    elif method == "xxtea":
        out = xxtea_decrypt(raw, key.encode())
    elif method == "xor":
        out = xor_decrypt(raw, key.encode())
    elif method == "none":
        out = raw
    else:
        raise ValueError("Unknown method: " + method)

    os.makedirs(os.path.dirname(out_path) or ".", exist_ok=True)
    with open(out_path, "wb") as f:
        f.write(out)

    print("  [✓] Decrypted -> " + out_path)
    return out_path


def encrypt_file(in_path, out_path, method="xxtea", key="NAK2026VIP"):
    print("  [*] Reading: " + in_path)
    with open(in_path, "rb") as f:
        raw = f.read()

    if method == "xxtea":
        out = xxtea_encrypt(raw, key.encode())
    elif method == "xor":
        out = xor_decrypt(raw, key.encode())
    elif method == "none":
        out = raw
    else:
        raise ValueError("Unknown method: " + method)

    os.makedirs(os.path.dirname(out_path) or ".", exist_ok=True)
    with open(out_path, "wb") as f:
        f.write(out)

    print("  [✓] Encrypted -> " + out_path)
    return out_path


