def get_device_model():
    try:
        if os.path.isdir("/data/data/com.termux"):
            try:
                with open("/system/build.prop", "r") as f:
                    for line in f:
                        if line.startswith("ro.product.model="):
                            return line.split("=", 1)[1].strip()
            except Exception:
                pass
            return "Android Device"
        if platform.system() == "Linux":
            try:
                with open("/etc/hostname") as f:
                    return f.read().strip()
            except Exception:
                pass
        return platform.node() or "Unknown"
    except Exception:
        return "Unknown"


def get_device_info():
    return {
        "device": get_device_model(),
        "os": "%s %s (%s)" % (platform.system(), platform.release(), platform.machine()),
        "ver": platform.version(),
    }


def get_hwid():
    parts = [
        platform.node(),
        platform.machine(),
        platform.system(),
        str(uuid.getnode()),
    ]
    try:
        parts.append(socket.gethostbyname(socket.gethostname()))
    except Exception:
        pass
    raw = "|".join(parts).encode()
    return hashlib.sha256(raw).hexdigest()[:32].upper()


