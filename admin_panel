@app.route("/admin/api/create", methods=["POST"])
def api_create():
    if not is_logged_in():
        return jsonify({"ok": False, "reason": "auth"}), 401

    d = request.form
    key = (d.get("key") or "").strip()
    if not key:
        return jsonify({"ok": False, "reason": "missing_key"}), 400

    db = load_db()
    if key in db:
        return jsonify({"ok": False, "reason": "key_exists"}), 409

    try:
        expiry = _dt(
            int(d.get("year", 2027)),
            int(d.get("month", 12)),
            int(d.get("day", 31)),
            int(d.get("hour", 23)),
            int(d.get("minute", 0)),
        )
    except ValueError:
        return jsonify({"ok": False, "reason": "bad_date"}), 400

    db[key] = {
        "expiry": expiry.isoformat(),
        "hwid": None,
        "note": d.get("note", ""),
        "device": None,
        "os": None,
        "ver": None,
        "last_login": None,
        "login_count": 0,
        "history": [],
    }
    save_db(db)
    return jsonify({"ok": True, "key": key, "expiry": expiry.isoformat()})


@app.route("/admin/api/update", methods=["POST"])
def api_update():
    if not is_logged_in():
        return jsonify({"ok": False, "reason": "auth"}), 401

    d = request.form
    old_key = (d.get("old_key") or "").strip()
    new_key = (d.get("new_key") or old_key).strip()

    if not old_key:
        return jsonify({"ok": False, "reason": "missing_key"}), 400

    db = load_db()
    if old_key not in db:
        return jsonify({"ok": False, "reason": "not_found"}), 404

    lic = db[old_key]

    if new_key != old_key:
        if new_key in db:
            return jsonify({"ok": False, "reason": "key_exists"}), 409
        del db[old_key]

    try:
        expiry = _dt(
            int(d.get("year", 2027)),
            int(d.get("month", 12)),
            int(d.get("day", 31)),
            int(d.get("hour", 23)),
            int(d.get("minute", 0)),
        )
        lic["expiry"] = expiry.isoformat()
    except ValueError:
        return jsonify({"ok": False, "reason": "bad_date"}), 400

    if "note" in d and d.get("note"):
        lic["note"] = d.get("note")
    if d.get("reset_hwid") == "1":
        lic["hwid"] = None
        lic["device"] = None
        lic["os"] = None
        lic["ver"] = None
        lic["history"] = []

    db[new_key] = lic
    save_db(db)
    return jsonify({"ok": True, "key": new_key, "expiry": lic["expiry"]})


@app.route("/admin/api/renew", methods=["POST"])
def api_renew():
    """Add days to a key's expiry."""
    if not is_logged_in():
        return jsonify({"ok": False, "reason": "auth"}), 401

    key  = (request.form.get("key") or "").strip()
    days = request.form.get("days", "30")
    try:
        days = int(days)
    except ValueError:
        return jsonify({"ok": False, "reason": "bad_days"}), 400

    db = load_db()
    if key not in db:
        return jsonify({"ok": False, "reason": "not_found"}), 404

    lic = db[key]
    try:
        expiry = datetime.datetime.fromisoformat(lic["expiry"])
    except Exception:
        return jsonify({"ok": False, "reason": "bad_license"}), 500

    # If already expired, start from now; else extend from current expiry
    base = max(expiry, now())
    new_expiry = base + datetime.timedelta(days=days)

    lic["expiry"] = new_expiry.isoformat()
    db[key] = lic
    save_db(db)

    return jsonify({
        "ok": True,
        "key": key,
        "expiry": new_expiry.isoformat(),
        "days_added": days,
    })


@app.route("/admin/api/delete", methods=["POST"])
def api_delete():
    if not is_logged_in():
        return jsonify({"ok": False, "reason": "auth"}), 401
    key = (request.form.get("key") or "").strip()
    db = load_db()
    if key not in db:
        return jsonify({"ok": False, "reason": "not_found"}), 404
    del db[key]
    save_db(db)
    return jsonify({"ok": True})


@app.route("/admin/api/unbind", methods=["POST"])
def api_unbind():
    if not is_logged_in():
        return jsonify({"ok": False, "reason": "auth"}), 401
    key = (request.form.get("key") or "").strip()
    db = load_db()
    if key not in db:
        return jsonify({"ok": False, "reason": "not_found"}), 404
    db[key]["hwid"] = None
    db[key]["device"] = None
    db[key]["os"] = None
    db[key]["ver"] = None
    db[key]["history"] = []
    save_db(db)
    return jsonify({"ok": True})


