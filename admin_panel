      <div class="stat-num" id="stat-total">0</div>
      <div class="stat-lbl">Total Devices</div>
    </div>
    <div class="stat">
      <div class="stat-num" id="stat-active">0</div>
      <div class="stat-lbl">Active Now</div>
    </div>
  </div>
  <div class="card">
    <h2>📱 DEVICES</h2>
    <div class="search-box">
      <span class="search-icon">🔍</span>
      <input id="searchDevices" type="text"
             placeholder="Search device, key, OS, HWID..."
             oninput="onSearchDevices()">
      <button class="clear-btn" id="clearDevices" onclick="clearSearch('devices')">✕</button>
    </div>
    <div class="search-info" id="searchInfoDevices"></div>
    <button class="alt" onclick="loadDevices()">🔄 REFRESH</button>
    <div id="deviceList" style="margin-top:16px;"></div>
  </div>
</div>

<!-- CREATE PAGE -->
<div class="page" id="page-create">
  <div class="card">
    <h2>➕ CREATE NEW KEY</h2>
    <label>License Key</label>
    <input id="c_key" placeholder="NAK-XXXX-XXXX">
    <label>Note (optional)</label>
    <input id="c_note" placeholder="customer name">
    <label>Expiry Date</label>
    <div class="row">
      <input id="c_year"  type="number" placeholder="Year"  value="2027">
      <input id="c_month" type="number" placeholder="Month" value="12" min="1" max="12">
      <input id="c_day"   type="number" placeholder="Day"   value="31" min="1" max="31">
    </div>
    <label>Expiry Time</label>
    <div class="row">
      <input id="c_hour"   type="number" placeholder="Hour"   value="23" min="0" max="23">
      <input id="c_minute" type="number" placeholder="Min"    value="0"  min="0" max="59">
    </div>
    <button onclick="createKey()">CREATE KEY</button>
  </div>
</div>

<!-- EDIT PAGE -->
<div class="page" id="page-edit">
  <div class="card">
    <h2>✏️ EDIT / CHANGE KEY</h2>
    <label>Current Key</label>
    <input id="u_old" placeholder="old key">
    <label>New Key (blank = keep)</label>
    <input id="u_new" placeholder="new key (optional)">
    <label>New Expiry Date</label>
    <div class="row">
      <input id="u_year"  type="number" value="2027">
      <input id="u_month" type="number" value="12" min="1" max="12">
      <input id="u_day"   type="number" value="31" min="1" max="31">
    </div>
    <label>New Expiry Time</label>
    <div class="row">
      <input id="u_hour"   type="number" value="23" min="0" max="23">
      <input id="u_minute" type="number" value="0"  min="0" max="59">
    </div>
    <label>New Note (optional)</label>
    <input id="u_note" placeholder="leave blank to keep">
    <label style="display:flex;align-items:center;gap:10px;
                  text-transform:none;letter-spacing:0;
                  font-size:13px;color:#c8d4e0;">
      <input type="checkbox" id="u_reset"
             style="width:auto;padding:0;transform:scale(1.3);">
      Reset HWID + Device binding
    </label>
    <button onclick="updateKey()">UPDATE KEY</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
let DB_CACHE = {};
let SEARCH_KEYS = "";
let SEARCH_DEVICES = "";

function switchTab(name, e) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  e.target.classList.add('active');
  document.getElementById('page-' + name).classList.add('active');
  if (name === 'devices') loadDevices();
  if (name === 'keys') loadList();
}

function toast(msg, isErr) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show' + (isErr ? ' err' : '');
  setTimeout(() => t.className = 'toast' + (isErr ? ' err' : ''), 2600);
}

async function post(url, data) {
  const r = await fetch(url, {
    method: 'POST',
    headers: {'Content-Type':'application/x-www-form-urlencoded'},
    body: new URLSearchParams(data),
  });
  return await r.json();
}

// ---------------- SEARCH ----------------
function onSearchKeys() {
  SEARCH_KEYS = document.getElementById('searchKeys').value.toLowerCase();
  document.getElementById('clearKeys').classList.toggle('show', SEARCH_KEYS.length > 0);
  renderKeys();
}

function onSearchDevices() {
  SEARCH_DEVICES = document.getElementById('searchDevices').value.toLowerCase();
  document.getElementById('clearDevices').classList.toggle('show', SEARCH_DEVICES.length > 0);
  renderDevices();
}

function clearSearch(which) {
  if (which === 'keys') {
    document.getElementById('searchKeys').value = '';
    SEARCH_KEYS = '';
    document.getElementById('clearKeys').classList.remove('show');
    renderKeys();
  } else {
    document.getElementById('searchDevices').value = '';
    SEARCH_DEVICES = '';
    document.getElementById('clearDevices').classList.remove('show');
    renderDevices();
  }
}

// ---------------- CREATE / UPDATE ----------------
async function createKey() {
  const data = {
    key:    document.getElementById('c_key').value.trim(),
    note:   document.getElementById('c_note').value.trim(),
    year:   document.getElementById('c_year').value,
    month:  document.getElementById('c_month').value,
    day:    document.getElementById('c_day').value,
    hour:   document.getElementById('c_hour').value,
    minute: document.getElementById('c_minute').value,
  };
  if (!data.key) return toast('Enter a key', true);
  const j = await post('/admin/api/create', data);
  if (j.ok) {
    toast('✅ Key created: ' + j.key);
    document.getElementById('c_key').value = '';
    loadList();
  } else toast('❌ ' + j.reason, true);
}

async function updateKey() {
  const data = {
    old_key: document.getElementById('u_old').value.trim(),
    new_key: document.getElementById('u_new').value.trim(),
    note:    document.getElementById('u_note').value.trim(),
    year:    document.getElementById('u_year').value,
    month:   document.getElementById('u_month').value,
    day:     document.getElementById('u_day').value,
    hour:    document.getElementById('u_hour').value,
    minute:  document.getElementById('u_minute').value,
    reset_hwid: document.getElementById('u_reset').checked ? '1' : '0',
  };
  if (!data.old_key) return toast('Enter current key', true);
  const j = await post('/admin/api/update', data);
  if (j.ok) { toast('✅ Updated: ' + j.key); loadList(); }
  else toast('❌ ' + j.reason, true);
}

async function delKey(k) {
  if (!confirm('Delete key: ' + k + ' ?')) return;
  const j = await post('/admin/api/delete', {key: k});
  if (j.ok) { toast('🗑 Deleted'); loadList(); }
  else toast('❌ ' + j.reason, true);
}

async function unbindKey(k) {
  const j = await post('/admin/api/unbind', {key: k});
  if (j.ok) { toast('🔓 Unbound'); loadList(); }
  else toast('❌ ' + j.reason, true);
}

// ---------------- RENEW ----------------
async function renewKey(k, days) {
  const j = await post('/admin/api/renew', {key: k, days: days});
  if (j.ok) {
    toast('✅ Renewed ' + j.key + ' +' + j.days_added + 'd → ' + j.expiry.slice(0,16).replace('T',' '));
    loadList();
  } else toast('❌ ' + j.reason, true);
}

async function renewCustom(k) {
  const d = prompt('How many days to add?', '30');
  if (d === null) return;
  const n = parseInt(d, 10);
  if (isNaN(n) || n <= 0) return toast('Invalid number', true);
  renewKey(k, n);
}

// ---------------- RENDER ----------------
function renderDeviceBox(v) {
  if (!v.device && !v.hwid) {
    return '<div class="key-meta">📱 Device : <b>— No device yet —</b></div>';
  }
  let html = `
    <div class="device-box">
      <div class="device-title">
        <span class="dot"></span> 📱 DEVICE INFO
      </div>
      <div class="device-line"><span class="lbl">Model</span><span class="val hi">${v.device || 'Unknown'}</span></div>
      <div class="device-line"><span class="lbl">OS</span><span class="val">${v.os || 'Unknown'}</span></div>
      <div class="device-line"><span class="lbl">HWID</span><span class="val">${v.hwid ? v.hwid : 'FREE'}</span></div>
      ${v.last_login ? `<div class="device-line"><span class="lbl">Last</span><span class="val">${v.last_login.replace('T',' ').slice(0,16)}</span></div>` : ''}
      ${v.login_count ? `<div class="device-line"><span class="lbl">Count</span><span class="val hi">${v.login_count} login(s)</span></div>` : ''}
    </div>
  `;
  return html;
}

function renewRow(k) {
  return `
    <div class="renew-label"><span class="icon">⏰</span> RENEW EXPIRY</div>
    <div class="renew-row">
      <button onclick="renewKey('${k}', 1)">+1d</button>
      <button onclick="renewKey('${k}', 7)">+7d</button>
      <button onclick="renewKey('${k}', 30)">+30d</button>
      <button onclick="renewCustom('${k}')">+Custom</button>
    </div>
  `;
}

function matchKey(k, v, q) {
  if (!q) return true;
  const hay = [
    k,
    v.note || "",
    v.hwid || "",
    v.device || "",
    v.os || "",
    v.ver || "",
  ].join(" ").toLowerCase();
  return hay.includes(q);
}

function renderKeys() {
  const box = document.getElementById('keyList');
  box.innerHTML = '';
  const now = new Date();
  const keys = Object.keys(DB_CACHE);
  const filtered = keys.filter(k => matchKey(k, DB_CACHE[k], SEARCH_KEYS));

  const info = document.getElementById('searchInfoKeys');
  if (SEARCH_KEYS) {
    info.innerHTML = `Found <b>${filtered.length}</b> of <b>${keys.length}</b> keys`;
  } else {
    info.innerHTML = `Showing <b>${keys.length}</b> keys`;
  }

  if (filtered.length === 0) {
    box.innerHTML = '<div class="empty">No matching keys</div>';
    return;
  }

  for (const k of filtered) {
    const v = DB_CACHE[k];
    const exp = new Date(v.expiry);
    const expired = exp < now;
    const item = document.createElement('div');
    item.className = 'key-item' + (expired ? ' expired' : '');
    item.innerHTML = `
      <div class="key-name${expired?' expired':''}">
        <span class="kname">${k}</span>
      </div>
      <div class="key-meta">📅 <b>${v.expiry.replace('T',' ').slice(0,16)}</b></div>
      ${v.note ? `<div class="key-meta">📝 <b>${v.note}</b></div>` : ''}
      ${renderDeviceBox(v)}
      <div style="margin-top:10px;">
        <span class="tag ${expired?'bad':'ok'}">${expired?'EXPIRED':'ACTIVE'}</span>
        ${v.device ? `<span class="tag dev">📱 ${v.device}</span>` : ''}
        ${!v.hwid ? `<span class="tag free">FREE</span>` : ''}
      </div>
      ${renewRow(k)}
      <div class="key-actions" style="margin-top:12px;">
        <button class="danger" onclick="delKey('${k}')">DELETE</button>
        ${v.hwid ? `<button class="alt" onclick="unbindKey('${k}')">UNBIND</button>` : ''}
      </div>
    `;
    box.appendChild(item);
  }
}

function renderDevices() {
  const box = document.getElementById('deviceList');
  box.innerHTML = '';
  const now = new Date();

  let total = 0, active = 0;
  const entries = [];

  for (const k of Object.keys(DB_CACHE)) {
    const v = DB_CACHE[k];
    if (v.device || v.hwid) {
      total++;
      const exp = new Date(v.expiry);
      if (exp >= now) active++;
      if (!SEARCH_DEVICES || matchKey(k, v, SEARCH_DEVICES)) {
        entries.push({key: k, v: v});
      }
    }
  }

  document.getElementById('stat-total').textContent = total;
  document.getElementById('stat-active').textContent = active;

  const info = document.getElementById('searchInfoDevices');
  if (SEARCH_DEVICES) {
    info.innerHTML = `Found <b>${entries.length}</b> of <b>${total}</b> devices`;
  } else {
    info.innerHTML = `Showing <b>${entries.length}</b> devices`;
  }

  if (entries.length === 0) {
    box.innerHTML = '<div class="empty">No devices yet<br>Waiting for client logins...</div>';
    return;
  }

  entries.sort((a, b) => {
    const ta = a.v.last_login || "";
    const tb = b.v.last_login || "";
    return tb.localeCompare(ta);
  });

  for (const {key, v} of entries) {
    const exp = new Date(v.expiry);
    const expired = exp < now;
    const card = document.createElement('div');
    card.className = 'device-card';
    card.style.borderColor = expired ? '#ff555533' : '#00aaff33';
    card.innerHTML = `
      <div class="device-header">
        <div class="device-icon">📱</div>
        <div>
          <div class="device-name">${v.device || 'Unknown Device'}</div>
          <div class="device-key">Key: <b style="color:#00ff88;">${key}</b></div>
        </div>
      </div>
      <div class="device-box">
        <div class="device-title"><span class="dot"></span> SYSTEM INFO</div>
        <div class="device-line"><span class="lbl">Model</span><span class="val hi">${v.device || 'Unknown'}</span></div>
        <div class="device-line"><span class="lbl">OS</span><span class="val">${v.os || 'Unknown'}</span></div>
        <div class="device-line"><span class="lbl">HWID</span><span class="val">${v.hwid || 'FREE'}</span></div>
        ${v.last_login ? `<div class="device-line"><span class="lbl">Last</span><span class="val">${v.last_login.replace('T',' ').slice(0,16)}</span></div>` : ''}
        <div class="device-line"><span class="lbl">Count</span><span class="val hi">${v.login_count || 0} login(s)</span></div>
      </div>
      ${renewRow(key)}
      <div style="margin-top:10px;">
        <span class="tag ${expired?'bad':'ok'}">${expired?'EXPIRED':'ACTIVE'}</span>
      </div>
    `;
    box.appendChild(card);
  }
}

// ---------------- LOAD ----------------
async function loadList() {
  const r = await fetch('/admin/api/list');
  const j = await r.json();
  if (!j.ok) return;
  DB_CACHE = j.data;
  renderKeys();
}

async function loadDevices() {
  await loadList();
  renderDevices();
}

loadList();
</script>
</body>
</html>
