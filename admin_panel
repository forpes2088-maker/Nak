        u = request.form.get("user", "")
        p = request.form.get("pass", "")
        if u == ADMIN_USER and p == ADMIN_PASS:
            session["admin"] = True
            return redirect(url_for("admin_panel"))
        error = "Invalid credentials"
    return render_template_string(LOGIN_HTML, error=error)


