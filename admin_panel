@app.route("/check", methods=["GET", "POST"])
def check():
    data = request.args if request.method == "GET" else request.form
    key      = (data.get("key") or "").strip()
    hwid     = (data.get("hwid") or "").strip() or None
    device   = (data.get("device") or "").strip() or "Unknown"
    os_info  = (data.get("os") or "").strip() or "Unknown"
    ver      = (data.get("ver") or "").strip() or ""

    if not key:
        return jsonify({"ok": False, "reason": "missing_key"}), 400

    db = load_db()
    lic = db.get(key)
    if not lic:
        return jsonify({"ok": False, "reason": "invalid_key"}), 401

    try:
        expiry = datetime.datetime.fromisoformat(lic["expiry"])
    except Exception:
        return jsonify({"ok": False, "reason": "bad_license"}), 500

    if now() > expiry:
        return jsonify({
            "ok": False,
            "reason": "expired",
            "expiry": expiry.isoformat(),
        }), 403

    if hwid:
        if lic.get("hwid") is None:
            lic["hwid"] = hwid
        elif lic["hwid"] != hwid:
            return jsonify({
                "ok": False,
                "reason": "hwid_mismatch",
                "bound_hwid": lic["hwid"],
            }), 403

    ts = now().isoformat()
    lic["device"] = device
    lic["os"] = os_info
    lic["ver"] = ver
    lic["last_login"] = ts
    lic["login_count"] = int(lic.get("login_count", 0)) + 1

    history = lic.get("history", [])
    history.insert(0, {
        "time": ts,
        "device": device,
        "os": os_info,
        "hwid": hwid or "?",
        "ip": request.remote_addr or "?",
    })
    lic["history"] = history[:20]

    db[key] = lic
    save_db(db)

    return jsonify({
        "ok": True,
        "key": key,
        "hwid": hwid,
        "expiry": expiry.isoformat(),
        "server_time": ts,
        "note": lic.get("note", ""),
    })


def is_logged_in():
    return session.get("admin") is True


def require_login():
    if not is_logged_in():
        return redirect(url_for("admin_login"))
    return None


@app.route("/admin/login", methods=["GET", "POST"])
def admin_login():
    error = None
