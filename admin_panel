DB_FILE    = "licenses.json"


def _dt(y, m, d, h=23, mi=0):
    return datetime.datetime(y, m, d, h, mi, 0)


def now():
    return datetime.datetime.now()


def load_db():
    if not os.path.isfile(DB_FILE):
        seed = {
            "NAK2026VIP": {
                "expiry": _dt(2027, 6, 15, 18).isoformat(),
                "hwid": None,
                "note": "VIP master key",
                "device": None,
                "os": None,
                "ver": None,
                "last_login": None,
                "login_count": 0,
                "history": [],
            }
        }
        save_db(seed)
        return seed
    try:
        with open(DB_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return {}


def save_db(data):
    with open(DB_FILE, "w") as f:
        json.dump(data, f, indent=2)


